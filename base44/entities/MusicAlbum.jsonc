{
  "name": "MusicAlbum",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "symphonic, piano, songs"
    },
    "year": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "longDescription": {
      "type": "string"
    },
    "cover": {
      "type": "string"
    },
    "background": {
      "type": "string"
    },
    "credits": {
      "type": "string"
    },
    "streamingLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "sortOrder": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "slug"
  ]
}