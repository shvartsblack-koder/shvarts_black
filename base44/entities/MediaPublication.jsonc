    },
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "type": {
      "type": "string",
      "description": "\u0418\u043d\u0442\u0435\u0440\u0432\u044c\u044e, \u0420\u0435\u0446\u0435\u043d\u0437\u0438\u044f, \u0421\u0442\u0430\u0442\u044c\u044f, \u0420\u0430\u0434\u0438\u043e, \u0422\u0412, \u041f\u043e\u0434\u043a\u0430\u0441\u0442"
